config_version=5

[application]
config/name="Paper, Plastic, Pew!"
config/description="A multiverse top-down twin-stick shooter across paper and plastic dimensions."
config/icon="res://assets/icon.svg"
run/main_scene="res://core/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.1, 0.1, 0.12, 1)

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[layer_names]
3d_physics/layer_1="world"
3d_physics/layer_2="actors"
